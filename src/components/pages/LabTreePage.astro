---
import Base from '../../layouts/Base.astro';
import Tree from '../tree/Tree.astro';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

// Isolated prototype of the tree, for validation. Not linked and not indexed.
const { locale } = Astro.props;
---

<Base locale={locale} path="/lab/tree/" title="Tree prototype" noindex>
  <div class="container lab">
    <p class="mono tag">lab / tree — prototype</p>
    <Tree locale={locale} />
  </div>
</Base>

<style>
  .lab {
    padding-top: 2rem;
  }
  .tag {
    color: var(--severity);
    margin-bottom: 2rem;
  }
</style>
