---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../Eyebrow.astro';
import { localizePath, t, type Locale } from '../../i18n';
import { pillarOf } from '../../data/nodes';
import type { Page } from '../../lib/pages';

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const ui = t(locale);
const data = page.entry.data;
const { Content } = await render(page.entry);
---

<Base
  locale={locale}
  path={`/${page.slug}/`}
  title={data.title}
  description={data.description}
  ogImage={`/og/${locale}/${page.slug}.png`}
>
  <article class="container section" data-pillar={pillarOf[data.node]}>
    <p class="back mono">
      <a href={localizePath('/#projects', locale)}>← {ui.nav.tree}</a>
    </p>
    <header>
      <Eyebrow text={data.eyebrow} />
      <h1>{data.title}</h1>
      <p class="lead">{data.lead}</p>
    </header>
    <div class="prose">
      <Content />
      <slot />
    </div>
  </article>
</Base>

<style>
  .section {
    padding-top: 2.5rem;
    max-width: 52rem;
  }
  .back a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--fg);
  }
  header {
    margin-block: 3rem 2.5rem;
  }
  h1 {
    view-transition-name: project-title;
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 800;
  }
  .lead {
    font-size: 1.25rem;
    color: var(--fg-muted);
  }
</style>
