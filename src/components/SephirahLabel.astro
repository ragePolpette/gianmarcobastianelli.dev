---
import { t, type Locale } from '../i18n';
import type { Sephirah } from '../data/sephirot';

interface Props {
  sephirah: Sephirah;
  locale: Locale;
}

const { sephirah, locale } = Astro.props;
const s = t(locale).sephirot[sephirah];
---

<p class="sephirah mono">
  <span class="dot" aria-hidden="true"></span>
  {s.name} <span class="meaning">· {s.meaning}</span>
</p>

<style>
  .sephirah {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .meaning {
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }
</style>
