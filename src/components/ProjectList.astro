---
import StatusBadge from './StatusBadge.astro';
import Text from './Text.astro';
import { localizePath, t, type Locale } from '../i18n';
import { pillarOf } from '../data/sephirot';
import { getTree, type Project } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const tree = await getTree(locale);
const href = (p: Project) => localizePath(`/projects/${p.slug}/`, locale);
---

<ol class="nodes">
  {tree.map(({ sephirah, primary, satellites }) => (
    <li
      class="node"
      data-pillar={pillarOf[sephirah]}
      data-sephirah={sephirah}
      data-seph-name={ui.sephirot[sephirah].name}
      data-project={primary.entry.data.name}
    >
      <p class="sephirah mono">
        <span class="dot" aria-hidden="true" />
        {ui.sephirot[sephirah].name}
        <span class="meaning">· {ui.sephirot[sephirah].meaning}</span>
      </p>
      <article class="card">
        <h3>
          <a href={href(primary)}>{primary.entry.data.name}</a>
        </h3>
        <p class="tagline">{primary.entry.data.tagline}</p>
        <div class="meta">
          <StatusBadge status={primary.entry.data.status} locale={locale} />
          <span class="mono stack">
            {primary.entry.data.stack.map((s, i) => (
              <>
                {i > 0 && ' · '}
                <Text value={s} locale={locale} />
              </>
            ))}
          </span>
        </div>
        {satellites.length > 0 && (
          <div class="satellites">
            <p class="mono orbits">{ui.project.orbits}</p>
            <ul>
              {satellites.map((s) => (
                <li>
                  <a href={href(s)}>{s.entry.data.name}</a>
                  <span class="sat-tagline">{s.entry.data.tagline}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </article>
    </li>
  ))}
</ol>

<style>
  .nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  .node {
    display: flex;
    flex-direction: column;
  }
  .sephirah {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .meaning {
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .card {
    flex: 1;
    position: relative;
    padding: 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }
  h3 {
    font-size: 1.375rem;
    margin-bottom: 0.4rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .tagline {
    color: var(--fg-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .stack {
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .satellites {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
  }
  .orbits {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .satellites ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .satellites a {
    font-weight: 600;
  }
  .sat-tagline {
    display: block;
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }
</style>
