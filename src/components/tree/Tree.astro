---
import NodeList from '../NodeList.astro';
import StatusBadge from '../StatusBadge.astro';
import { t, type Locale } from '../../i18n';
import { viewBox } from '../../data/tree';
import { buildTree, estimateWidth, type NodeView } from '../../lib/tree';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const { nodes, paths } = await buildTree(locale);

// Label metrics, in SVG user units.
const OFFSET = 36;
const SIZE = { seph: 13, name: 27, sum: 17, sat: 15 } as const;

function label(node: NodeView) {
  const right = node.side === 'right';
  const tx = right ? node.x + OFFSET : node.x - OFFSET;
  const width =
    Math.max(
      estimateWidth(node.eyebrow.toUpperCase(), SIZE.seph, 'mono'),
      estimateWidth(node.title ?? '', SIZE.name, 'display'),
      estimateWidth(node.summary ?? '', SIZE.sum, 'body'),
    ) + 24;
  return {
    tx,
    anchor: right ? 'start' : 'end',
    chipX: right ? tx - 12 : tx - width + 12,
    width,
  };
}

const baseNode = nodes.find((n) => n.nodeId === 'base');
const exodiaTargets = nodes.flatMap((n) => [
  ...(n.exodiaPart ? [{ x: n.x, y: n.y }] : []),
  ...n.satellites.filter((s) => s.exodiaPart).map((s) => ({ x: s.x, y: s.y, sat: true })),
]);
const exodiaCurves = baseNode
  ? exodiaTargets.map(({ x, y, ...rest }) => {
      const bend = x >= baseNode.x ? 200 : -200;
      const cx = (baseNode.x + x) / 2 + bend;
      const cy = (baseNode.y + y) / 2 + 60;
      return { d: `M${baseNode.x} ${baseNode.y} Q${cx} ${cy} ${x} ${y}`, sat: 'sat' in rest };
    })
  : [];

const pillars = ['right', 'left', 'center'] as const;

// Portrait framing for narrow screens: node columns plus room for a name under each node.
const xs = nodes.map((n) => n.x);
const ys = nodes.map((n) => n.y);
const compactViewBox = [
  Math.min(...xs) - 180,
  Math.min(...ys) - 60,
  Math.max(...xs) - Math.min(...xs) + 360,
  Math.max(...ys) - Math.min(...ys) + 150,
].join(' ');
---

<section class="tree" data-tree aria-labelledby="tree-title">
  <div class="toolbar">
    <p class="hint mono" id="tree-hint">
      {ui.tree.hint}
    </p>
    <div class="switch" role="group" aria-label={ui.tree.viewLabel} data-switch hidden>
      <button type="button" class="mono" data-view-btn="tree" aria-pressed="true">
        {ui.tree.viewTree}
      </button>
      <button type="button" class="mono" data-view-btn="list" aria-pressed="false">
        {ui.tree.viewList}
      </button>
    </div>
  </div>

  <p class="visually-hidden" id="tree-title">
    {ui.tree.label}
  </p>

  <div class="stage" data-stage data-panel="tree">
    <canvas class="particles" data-particles aria-hidden="true"></canvas>

    <svg
      class="tree-svg"
      viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}
      data-compact-viewbox={compactViewBox}
      role="group"
      aria-labelledby="tree-title"
      aria-describedby="tree-hint"
    >
      <defs>
        {pillars.map((p) => (
          <radialGradient id={`glow-${p}`}>
            <stop offset="0" class={`stop-${p}`} stop-opacity="0.55" />
            <stop offset="0.45" class={`stop-${p}`} stop-opacity="0.12" />
            <stop offset="1" class={`stop-${p}`} stop-opacity="0" />
          </radialGradient>
        ))}
      </defs>

      <g class="layer" data-depth="-1" aria-hidden="true">
        {paths.map((p) => (
          <g class="path" data-a={p.a} data-b={p.b}>
            <line class="rail" x1={p.x1} y1={p.y1} x2={p.x2} y2={p.y2} pathLength="1" />
            <line class="flow" x1={p.x1} y1={p.y1} x2={p.x2} y2={p.y2} pathLength="1" />
          </g>
        ))}
        {exodiaCurves.map((c) => (
          <path class="exodia-link" data-to-sat={c.sat ? '' : undefined} d={c.d} pathLength="1" />
        ))}
      </g>

      <g class="layer" data-depth="1">
        {nodes.map((n) => {
          const l = label(n);
          const visuals = (
            <>
              <circle class="halo" cx={n.x} cy={n.y} r="46" fill={`url(#glow-${n.pillar})`} />
              <circle class="ring" cx={n.x} cy={n.y} r="19" />
              <circle class="core" cx={n.x} cy={n.y} r="8" />
              {n.title && (
                <g class="label">
                  <rect class="chip" x={l.chipX} y={n.y - 38} width={l.width} height="84" rx="10" />
                  <text class="seph" x={l.tx} y={n.y - 16} text-anchor={l.anchor}>
                    {n.eyebrow.toUpperCase()}
                  </text>
                  <text class="name" x={l.tx} y={n.y + 11} text-anchor={l.anchor}>
                    {n.title}
                  </text>
                  <text class="sum" x={l.tx} y={n.y + 34} text-anchor={l.anchor}>
                    {n.summary}
                  </text>
                </g>
              )}
              {n.title && (
                <g class="clabel">
                  <rect
                    class="chip"
                    x={n.x - (estimateWidth(n.title, 30, 'display') + 24) / 2}
                    y={n.y + 36}
                    width={estimateWidth(n.title, 30, 'display') + 24}
                    height="44"
                    rx="10"
                  />
                  <text class="cname" x={n.x} y={n.y + 67} text-anchor="middle">
                    {n.title}
                  </text>
                </g>
              )}
            </>
          );
          return (
            <g
              class="node"
              data-node={n.nodeId}
              data-pillar={n.pillar}
              data-dormant={n.href ? undefined : ''}
              data-exodia-part={n.exodiaPart ? '' : undefined}
            >
              {n.href ? (
                <a
                  href={n.href}
                  data-key={n.nodeId}
                  aria-label={`${n.title}, ${n.eyebrow}. ${n.summary}`}
                >
                  {visuals}
                </a>
              ) : (
                <g aria-hidden="true">{visuals}</g>
              )}
              {n.satellites.map((s) => {
                const right = n.side === 'right';
                const sx = right ? s.x + 16 : s.x - 16;
                const w = estimateWidth(s.name, SIZE.sat, 'mono') + 20;
                return (
                  <a
                    class:list={['sat', right ? 'sat-r' : 'sat-l']}
                    href={s.href}
                    data-key={`sat:${s.slug}`}
                    data-parent={n.nodeId}
                    data-exodia-part={s.exodiaPart ? '' : undefined}
                    aria-label={`${s.name}, ${s.eyebrow}. ${s.summary}`}
                  >
                    <line class="tether" x1={n.x} y1={n.y} x2={s.x} y2={s.y} />
                    <rect
                      class="chip"
                      x={right ? sx - 8 : sx - w + 8}
                      y={s.y - 15}
                      width={w}
                      height="30"
                      rx="8"
                    />
                    <circle class="sat-core" cx={s.x} cy={s.y} r="6" />
                    <text class="sat-name" x={sx} y={s.y + 5} text-anchor={right ? 'start' : 'end'}>
                      {s.name}
                    </text>
                  </a>
                );
              })}
            </g>
          );
        })}
      </g>
    </svg>

    <div class="m-caption" data-caption data-open={ui.tree.open} aria-live="polite">
      <p class="mono cap-hint">{ui.tree.tapHint}</p>
    </div>

    <aside class="preview" aria-hidden="true" data-preview-root>
      <div class="pv pv-default" data-preview="">
        <p class="mono pv-hint">{ui.tree.hint}</p>
      </div>
      {nodes
        .filter((n) => n.title)
        .map((n) => (
          <div class="pv" data-preview={n.nodeId} data-pillar={n.pillar} hidden>
            <p class="mono pv-seph">{n.eyebrow}</p>
            <p class="pv-title">{n.title}</p>
            <p class="pv-text">{n.tagline}</p>
            {n.project && (
              <p class="pv-meta">
                <StatusBadge status={n.project.entry.data.status} locale={locale} />
                <span class="mono">{n.project.entry.data.stack.slice(0, 4).join(' · ')}</span>
              </p>
            )}
            {n.nodeId === 'base' && <p class="mono pv-exodia">{ui.tree.exodiaHint}</p>}
          </div>
        ))}
      {nodes.flatMap((n) =>
        n.satellites.map((s) => (
          <div class="pv" data-preview={`sat:${s.slug}`} data-pillar={n.pillar} hidden>
            <p class="mono pv-seph">
              {s.eyebrow} · {ui.project.orbits}
            </p>
            <p class="pv-title">{s.name}</p>
            <p class="pv-text">{s.tagline}</p>
          </div>
        )),
      )}
    </aside>
  </div>

  <div class="mobile-bar" aria-hidden="true" data-mobile-bar>
    <svg class="mini" viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}>
      {paths.map((p) => (
        <line x1={p.x1} y1={p.y1} x2={p.x2} y2={p.y2} />
      ))}
      {nodes.map((n) => (
        <circle cx={n.x} cy={n.y} r="34" data-mini={n.nodeId} data-pillar={n.pillar} />
      ))}
    </svg>
    <p class="mini-label mono" data-mini-label>
      {ui.tree.mobileHint}
    </p>
  </div>

  <div class="list" data-panel="list">
    <NodeList locale={locale} />
  </div>
</section>

<script>
  import { initTree } from './tree-client';

  for (const root of document.querySelectorAll<HTMLElement>('[data-tree]')) initTree(root);
</script>

<style>
  .tree {
    --active: var(--gold);
    position: relative;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }
  .hint {
    margin: 0;
    color: var(--fg-muted);
  }
  .switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
  }
  .switch[hidden] {
    display: none;
  }
  .switch button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .switch button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  /* View toggle (only once JS has taken over: without JS both views are shown). */
  .tree[data-view='tree'] [data-panel='list'],
  .tree[data-view='list'] [data-panel='tree'] {
    display: none;
  }
  .tree[data-view='list'] .hint {
    visibility: hidden;
  }

  .stage {
    position: relative;
    margin-bottom: 3rem;
  }
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .tree-svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .layer {
    transition: transform 0.4s ease-out;
  }

  /* Pillar colours inside the SVG. */
  .stop-right {
    stop-color: var(--cyan);
  }
  .stop-left {
    stop-color: var(--magenta);
  }
  .stop-center {
    stop-color: var(--gold);
  }

  /* Paths */
  .rail {
    stroke: var(--fg);
    stroke-opacity: 0.14;
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 0.7s ease-out,
      stroke-opacity 0.25s;
  }
  .flow {
    stroke: var(--active);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0.04 0.08;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .path.on .rail {
    stroke-opacity: 0.55;
  }
  .path.on .flow {
    opacity: 1;
    animation: flow 1.2s linear infinite;
  }
  .path.on.rev .flow {
    animation-direction: reverse;
  }
  /* Ambient energy on touch screens (see setupAmbient). */
  .path.pulse .rail {
    stroke-opacity: 0.45;
  }
  .path.pulse .flow {
    stroke: var(--pulse, var(--active));
    opacity: 1;
    animation: flow 1.2s linear infinite;
  }
  .path.pulse.rev .flow {
    animation-direction: reverse;
  }
  .node.pulse .halo {
    opacity: 1;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -0.12;
    }
  }

  .exodia-link {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.8s ease-out,
      opacity 0.3s;
  }
  .stage.assembled .exodia-link {
    stroke-dashoffset: 0;
    opacity: 0.7;
  }

  /* Nodes */
  .node a,
  .sat {
    cursor: pointer;
    outline: none;
  }
  .halo {
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .ring {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-opacity: 0.8;
    transition:
      stroke-width 0.2s,
      stroke 0.2s;
  }
  .core {
    fill: var(--accent);
  }
  .chip {
    fill: var(--bg);
    fill-opacity: 0.82;
    stroke: var(--accent);
    stroke-opacity: 0;
    transition: stroke-opacity 0.2s;
  }
  .seph {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    fill: var(--accent);
  }
  .name {
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 750;
    fill: var(--fg);
  }
  .sum {
    font-family: var(--font-body);
    font-size: 17px;
    fill: var(--fg-muted);
  }

  .node.active .halo,
  .stage.assembled .node[data-exodia-part] .halo {
    opacity: 1;
    transform: scale(1.25);
  }
  .node.active .ring,
  .node a:focus-visible .ring {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .node.active > a:not(.sat) .chip,
  .node > a:not(.sat):focus-visible .chip {
    stroke-opacity: 0.6;
  }

  /* The contact node sits off the paths and stays veiled until approached. */
  .node[data-node='upperMid'] .ring {
    stroke-dasharray: 3 5;
  }
  .node[data-node='upperMid'] .core {
    fill: none;
  }
  .node[data-node='upperMid'] .label {
    opacity: 0.45;
    transition: opacity 0.3s;
  }
  .node[data-node='upperMid'].active .label,
  .node[data-node='upperMid'] a:focus-visible .label {
    opacity: 1;
  }

  /* Dormant nodes: no project, no link, no filler. */
  .node[data-dormant] {
    opacity: 0.25;
  }

  /* Satellites */
  .tether {
    stroke: var(--accent);
    stroke-opacity: 0.35;
    stroke-dasharray: 3 5;
  }
  .sat-core {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .sat-name {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--fg);
  }
  .sat.active .sat-core,
  .sat:focus-visible .sat-core,
  .stage.assembled .sat[data-exodia-part] .sat-core {
    fill: var(--accent);
  }
  .sat.active .chip,
  .sat:focus-visible .chip,
  .stage.assembled .sat[data-exodia-part] .chip {
    stroke-opacity: 0.6;
  }

  /* Ignition: JS turns the tree off, then lights it node by node. */
  .stage[data-state='off'] .node:not(.lit) {
    opacity: 0.12;
  }
  .stage[data-state='off'] .path:not(.lit) .rail {
    stroke-dashoffset: 1;
  }
  .node {
    transition: opacity 0.5s ease-out;
  }

  /* Preview panel: sits in the empty bottom-left corner of the tree. */
  .preview {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(30%, 22rem);
    padding: 1rem 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    pointer-events: none;
  }
  .pv[hidden] {
    display: none;
  }
  .pv p {
    margin: 0 0 0.4rem;
  }
  .pv-hint {
    color: var(--fg-muted);
    margin: 0;
  }
  .pv-seph {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
  }
  .pv-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.375rem;
    line-height: 1.15;
  }
  .pv-text {
    color: var(--fg-muted);
    font-size: 0.9375rem;
  }
  .pv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    align-items: center;
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .pv-exodia {
    color: var(--gold);
    font-size: 0.75rem;
  }

  /* Mobile: the tree becomes a guided scroll over the list. */
  .mobile-bar {
    display: none;
  }
  .m-caption,
  .clabel {
    display: none;
  }
  .cname {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 750;
    fill: var(--fg);
  }

  /* Tablets and wide phones: the full labelled tree, with a tap caption instead of hover. */
  @media (max-width: 63.99rem) {
    .switch,
    .hint,
    .preview {
      display: none;
    }
    .tree .stage {
      display: block !important;
      margin: 0 auto 1rem;
    }
    .m-caption {
      display: block;
      min-height: 7.5rem;
      margin-top: 0.5rem;
      padding: 1rem 1.25rem;
      background: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
    .m-caption :global(p) {
      margin: 0 0 0.35rem;
    }
    .m-caption :global(.cap-hint) {
      color: var(--fg-muted);
    }
    .m-caption :global(.cap-eyebrow) {
      color: var(--accent, var(--gold));
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
    }
    .m-caption :global(.cap-title) {
      font-family: var(--font-display);
      font-weight: 750;
      font-size: 1.375rem;
      line-height: 1.15;
    }
    .m-caption :global(.cap-text) {
      color: var(--fg-muted);
      font-size: 0.9375rem;
    }
    .m-caption :global(.cap-open) {
      color: var(--fg);
    }
    .tree [data-panel='list'] {
      display: block !important;
    }
    .mobile-bar {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-inline: calc(var(--gutter) * -1);
      margin-bottom: 1rem;
      padding: 0.5rem var(--gutter);
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .mini {
      flex: none;
      width: 5.5rem;
      height: auto;
    }
    .mini line {
      stroke: var(--fg);
      stroke-opacity: 0.2;
      stroke-width: 8;
    }
    .mini circle {
      fill: var(--bg);
      stroke: var(--accent);
      stroke-width: 10;
      transition: fill 0.2s;
    }
    .mini circle.on {
      fill: var(--accent);
    }
    .mini-label {
      margin: 0;
      color: var(--fg-muted);
    }
    .mini-label strong {
      color: var(--fg);
    }
  }

  /* Narrow phones: portrait framing, a name under each node, bigger nodes. */
  @media (max-width: 47.99rem) {
    .label,
    .sat .chip,
    .sat-name,
    .tether,
    .exodia-link[data-to-sat] {
      display: none;
    }
    .clabel {
      display: inline;
    }
    .tree .stage {
      max-width: 30rem;
    }
    .halo,
    .ring,
    .core,
    .sat-core {
      transform-box: fill-box;
      transform-origin: center;
    }
    .halo {
      transform: scale(1.6);
    }
    .node.active .halo {
      transform: scale(2);
    }
    .ring,
    .core {
      transform: scale(1.6);
    }
    /* Satellites move up and out, clear of the name under their node. */
    .sat-r .sat-core {
      transform: translate(40px, -86px) scale(1.8);
    }
    .sat-l .sat-core {
      transform: translate(-40px, -86px) scale(1.8);
    }
    .rail {
      stroke-width: 3;
    }
    .flow {
      stroke-width: 5;
    }
    .exodia-link {
      stroke-width: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path.on .flow {
      animation: none;
      stroke-dasharray: none;
      opacity: 0.8;
    }
    .layer {
      transition: none;
    }
  }
</style>
