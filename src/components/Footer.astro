---
import Email from './Email.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<footer class="site-footer" id="contact">
  <div class="container">
    <h2>{ui.contact.title}</h2>
    <ul class="links">
      <li>
        <span class="mono label">{ui.contact.github}</span>
        <a href={site.github} rel="me noopener">
          github.com/ragePolpette
        </a>
      </li>
      <li>
        <span class="mono label">{ui.contact.linkedin}</span>
        <a href={site.linkedin} rel="me noopener">
          linkedin.com/in/gianmarco-bastianelli
        </a>
      </li>
      <li>
        <span class="mono label">{ui.contact.email}</span>
        <Email fallback={ui.contact.emailFallback} />
      </li>
    </ul>
    <p class="mono note">{ui.footer.note}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 1.5rem;
  }
  .links {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .links li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: baseline;
    gap: 1rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 30rem) {
    .links li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .label,
  .note {
    color: var(--fg-muted);
  }
</style>
