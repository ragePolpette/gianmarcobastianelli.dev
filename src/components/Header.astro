---
import LangSwitch from './LangSwitch.astro';
import { localizePath, t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const ui = t(locale);
const home = localizePath('/', locale);
const links = [
  { href: `${home}#projects`, label: ui.nav.projects, match: null },
  { href: localizePath('/work/', locale), label: ui.nav.work, match: '/work/' },
  { href: localizePath('/about/', locale), label: ui.nav.about, match: '/about/' },
  { href: localizePath('/contact/', locale), label: ui.nav.contact, match: '/contact/' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      {site.name}
    </a>
    <nav aria-label={ui.a11y.primaryNav}>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.match === path ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LangSwitch locale={locale} path={path} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 3.75rem;
    padding-block: 0.5rem;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    margin-right: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.9375rem;
    color: var(--fg-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }
  @media (max-width: 40rem) {
    /* On small screens the nav drops to its own row under the name. */
    nav {
      order: 3;
      width: 100%;
    }
    ul {
      gap: 0.25rem 1rem;
    }
  }
</style>
