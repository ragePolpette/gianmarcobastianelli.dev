---
import Base from '../layouts/Base.astro';
import { localizePath, t } from '../i18n';

const ui = t('en');
const it = t('it');
---

<Base locale="en" path="/404/" title={ui.notFound.title} noindex>
  <section class="container nf">
    <p class="mono code">404</p>
    <h1>{ui.notFound.title}</h1>
    <p>{ui.notFound.body}</p>
    <p>
      <a href={localizePath('/', 'en')}>{ui.notFound.home}</a>
    </p>
    <p lang="it" class="alt">
      {it.notFound.body} <a href={localizePath('/', 'it')}>{it.notFound.home}</a>
    </p>
  </section>
</Base>

<style>
  .nf {
    padding-block: 6rem;
  }
  .code {
    color: var(--magenta);
  }
  .alt {
    margin-top: 2rem;
    color: var(--fg-muted);
  }
</style>
