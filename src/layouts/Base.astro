---
import '../styles/global.css';
import syneLatin from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, locales, localizePath, t, withBase, type Locale } from '../i18n';
import { PREVIEW } from 'astro:env/server';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  /** Locale-neutral path of this page, e.g. "/projects/yesod/". */
  path: string;
  title?: string;
  description?: string;
  /** Root-relative path (without base) of the Open Graph image (1200×630 PNG). */
  ogImage?: string;
  noindex?: boolean;
}

const { locale, path, title, description, ogImage, noindex = false } = Astro.props;
const ui = t(locale);
const pageTitle = title ? `${title} — ${site.name}` : ui.meta.title;
const pageDescription = description ?? ui.meta.description;
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(localizePath(path, locale), origin).href;
const ogLocale = { en: 'en_US', it: 'it_IT' } as const;
const ogImageUrl = new URL(withBase(ogImage ?? `/og/${locale}/home.png`), origin).href;
// Preview deployments (e.g. GitHub Pages) must never be indexed.
const robotsNoindex = noindex || PREVIEW;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizePath(path, l), origin).href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath(path, defaultLocale), origin).href}
    />
    {robotsNoindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.og.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#07070b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preload" href={syneLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui.a11y.skip}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
